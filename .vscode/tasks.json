{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firebase Emulator: Run Rules & Concurrency Tests",
      "type": "shell",
      "command": "firebase emulators:exec --only firestore,auth 'npm run test:emulator'",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Firebase Emulator: Start Emulator Suite",
      "type": "shell",
      "command": "firebase emulators:start --only firestore,auth",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
