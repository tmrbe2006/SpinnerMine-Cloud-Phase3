# ==============================================================================
# SpinnerMine Cloud — Environment Configuration Template
# ==============================================================================
# WARNING: Do NOT commit production secrets, private keys, or API tokens to source control.
# Production secrets must be configured via Google Cloud Secret Manager or AI Studio Secrets.
# ==============================================================================

# GEMINI_API_KEY: Injected at runtime from secure environment for AI Studio services.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public origin where this application is hosted (Cloud Run URL).
APP_URL="MY_APP_URL"

# GAME_SERVER_SECRET: Authoritative server-side HMAC secret for signing and verifying game outcomes.
# SECURITY REQUIREMENTS:
# - Minimum 256-bit cryptographic entropy (at least 32 characters or 64 hex characters).
# - NEVER hardcode a fallback secret in production.
# - Production services will refuse to run if this secret is missing or under 32 characters.
# - Test secrets are isolated strictly to local CI/test suites and must not match production.
# Generate a cryptographically secure 256-bit secret via terminal:
#   openssl rand -hex 32
GAME_SERVER_SECRET="GENERATE_AND_PASTE_RANDOM_256_BIT_SECRET_HERE_MIN_32_CHARS"

# FIREBASE_PROJECT_ID: Optional override for Firebase Admin SDK project identifier.
FIREBASE_PROJECT_ID="spinnermine-cloud-production"

# VITE_BACKEND_API_URL: Public HTTPS backend endpoint (Google Cloud Run) for Electron and remote clients.
# VITE_BACKEND_API_URL="https://spinnermine-backend-<hash>-<region>.a.run.app"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional) Local / external path or JSON string of service account key
# for administrative access when running outside Google Cloud Run ADC.
# FIREBASE_SERVICE_ACCOUNT_KEY="./service-account-key.json"

