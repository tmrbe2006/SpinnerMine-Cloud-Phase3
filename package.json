{
  "name": "spinnermine-cloud",
  "private": true,
  "version": "1.0.0",
  "description": "SpinnerMine Cloud Official Mining & Interactive Gaming Platform",
  "author": "SpinnerMine Cloud Engineering",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:electron-web": "vite build --mode electron",
    "build:electron": "tsx scripts/build-electron.ts",
    "validate:electron-dist": "tsx scripts/validate-dist-assets.ts",
    "build:electron-all": "npm run build:electron-web && npm run build:electron && npm run validate:electron-dist",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron dist-windows server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/emulator/**'",
    "test:core": "vitest run --exclude 'tests/emulator/**'",
    "test:emulator": "vitest run tests/emulator --fileParallelism=false",
    "pack:win": "electron-builder --win --x64 -c desktop/electron-builder.json5 -p never",
    "verify:mining": "tsx scripts/verify-real-mining.ts",
    "test:windows-lifecycle": "npm run build:electron-web && tsx tests/windows-lifecycle-check.ts",
    "test:workers": "npm --prefix workers test",
    "deploy:worker": "npm --prefix workers run deploy",
    "set-admin": "tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
